<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Windows app. The release workflow replaces @VERSION@
  (four numbers, e.g. 1.0.6.0). Publisher must match the subject of the
  signing certificate (packaging/windows/explorer-msix.cer).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="MSatyamMishra.Explorer"
    Publisher="CN=MSatyam-Mishra"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Explorer</DisplayName>
    <PublisherDisplayName>MSatyam-Mishra</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>The universal file manager: open, edit and share almost any file.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Explorer" Executable="explorer.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Explorer"
        Description="The universal file manager: open, edit and share almost any file."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
